cff-version: 1.2.0
title: "PM_Inv: MATLAB Package for Predominant Mode Surface-Wave Inversion"
message: "If you use this software in your research, please cite both the software and the associated journal publication."
type: software

authors:
  - family-names: "Bhaumik"
    given-names: "Mrinal"
    affiliation: "Utah State University"
